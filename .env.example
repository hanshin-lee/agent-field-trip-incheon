# ── Provided to every participant at the event (no personal billing) ──
# Fill in whichever you actually got handed. The /api/agent route picks the
# provider from AGENT_PROVIDER below, so you only need ONE to ship.

AGENT_PROVIDER=google          # google | openai | anthropic | runyour

GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Runyour Agent (몬드리안AI — event sponsor platform) ──
# Set both if your team drives the agent through Runyour rather than a raw API.
RUNYOUR_API_KEY=
RUNYOUR_BASE_URL=

# ── Optional ──
# Only if the 11:10 mission turns out to need maps/places.
NEXT_PUBLIC_MAP_KEY=
